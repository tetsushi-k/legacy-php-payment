{
    "name": "legacy-php-payment/modern",
    "description": "Legacy PHP payment modernization portfolio - modern layer",
    "type": "project",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "rector/rector": "^2.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "modern/src/App/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "modern/tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
